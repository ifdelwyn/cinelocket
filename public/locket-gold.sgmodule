[MITM]
hostname = %APPEND% api.revenuecat.com

[Script]
LocketGold = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ifdelwyn/cinelocket/main/public/locket-gold.js
